# Configuration for the containerised tenant-service in docker-compose.dev.yml
# (profile "app"). Shared by `migrate` and `serve`, so DSN is only set once.
# Local development credentials only; see README.md for the full variable list.

DSN=postgres://tenants:tenants@postgres:5432/tenants?sslmode=disable

PORT=8080
GRPC_PORT=50051

LOG_LEVEL=debug
TRACING_ENABLED=false

KRATOS_ADMIN_URL=http://kratos:4434

# The issuer must match the `iss` claim Hydra puts in tokens (urls.self.issuer in
# docker/hydra/hydra.yml), while the keys are fetched over the compose network.
AUTHENTICATION_ENABLED=true
AUTHENTICATION_ISSUER=http://localhost:4444
AUTHENTICATION_JWKS_URL=http://hydra:4444/.well-known/jwks.json
AUTHENTICATION_REQUIRED_SCOPE=tenant-service
# Comma-separated Hydra client ids allowed to call the service. start.sh creates
# this client at runtime, so set it to the printed "Auth Client ID" when needed.
AUTHENTICATION_ALLOWED_SUBJECTS=

WEBHOOKS_API_TOKEN=secret_api_key

# Permission events are only consumed by the authorization service.
KAFKA_ENABLED=false
